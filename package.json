{
  "name": "calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "codegen": "pnpm --filter @calendar/contract generate && pnpm --filter @calendar/api-client generate",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm codegen && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "fix": "oxlint --fix . && oxfmt --write ."
  },
  "devDependencies": {
    "oxfmt": "0.78.0"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@12.18.0"
}
