    "/api/meeting-types/{meetingTypeId}": {
      "get": {
        "operationId": "getMeetingType",
        "parameters": [
          {
            "name": "meetingTypeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
