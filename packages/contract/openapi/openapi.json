    "/api/meeting-types/{meetingTypeId}/availability": {
      "get": {
        "operationId": "getAvailability",
        "parameters": [
          {
            "name": "meetingTypeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
