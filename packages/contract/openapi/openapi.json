  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AvailabilityDay": {
        "type": "object",
        "required": [
          "date",
          "freeSlotsCount",
          "slots"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "freeSlotsCount": {
            "type": "integer",
            "format": "int32"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        }
      },
      "AvailabilityResponse": {
        "type": "object",
        "required": [
          "days"
        ],
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityDay"
            }
          }
        }
      },
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "meetingTypeId",
          "meetingType",
          "start",
          "end",
          "guestName",
          "guestEmail",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "meetingTypeId": {
            "type": "string"
          },
          "meetingType": {
            "$ref": "#/components/schemas/MeetingType"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          },
          "guestNotes": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateBookingRequest": {
        "type": "object",
        "required": [
          "meetingTypeId",
          "start",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "meetingTypeId": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "guestNotes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "CreateMeetingTypeRequest": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 480,
            "multipleOf": 5
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "MeetingType": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 480,
            "multipleOf": 5
          }
        }
      },
      "Slot": {
        "type": "object",
        "required": [
          "start",
          "end",
          "available"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "UpdateMeetingTypeRequest": {
        "type": "object",
        "required": [
          "title",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 480,
            "multipleOf": 5
          }
        }
      }
    }
  }
}
